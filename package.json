{
  "name": "django-auth-style",
  "private": true,
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "npm"
    },
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  },
  "dependencies": {
    "daisyui": "^5.0.42",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "rustywind": "^0.28.0"
  },
  "scripts": {
    "test": "rustywind --check-formatted ./auth_style/templates",
    "format": "rustywind --write ./auth_style/templates",
    "watch": "tailwindcss -i ./npm-src/styles.css -o ./auth_style/static/auth_style/dist/styles.css --watch",
    "build": "tailwindcss -i ./npm-src/styles.css -o ./auth_style/static/auth_style/dist/styles.css --minify"
  },
  "allowScripts": {
    "rustywind": true,
    "@parcel/watcher": false
  }
}
